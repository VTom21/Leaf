<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
<div class="wrapper">
{{#each animals}}
    <p>[<$index>] - [<name>]</p>
{{/each}}
</div>


<<card>>

<p>[<upper hello>]</p>
<p>[<lower HELLO>]</p>
<p>[<strlen hello>]</p>

<p>[<upper title>]</p>
<p>[<add 3 + 6>]</p>
<p>[<subtract 3 - 6>]</p>
<p>[<divide 3 / 6>]</p>
<p>[<multiply 3 * 6>]</p>
<p>[<evaluate 2 / 0.5>]</p>

<p>[<reverse hello?>]</p>
<p>[<max 10 20>]</p>
<p>[<min 10 20>]</p>
<p>[<round 5.7>]</p>
<p>[<absolute 5.7>]</p>

<p>[<first array>]</p>
<p>[<last array>]</p>

<p>[<randomFloat 100>]</p>
<p>[<randomInt 100>]</p>

<script src="src/index.js"></script>
</body>
</html>
